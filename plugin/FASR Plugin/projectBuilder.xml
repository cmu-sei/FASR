<?xml version="1.0" encoding="UTF-8"?>
<project name="FASRPlugin.build" default="makezip" basedir=".">
	<target name="makejar" description="Create a jar for the FASR Plugin project">
		<jar destfile="MagicDraw/plugins/FASR/lib/fasr.jar" includes="**/*.class" basedir="bin" />
	</target>
	<target name="makezip" depends="makejar">
		<zip basedir="MagicDraw" destfile="FASR.zip" includes="**/*"/>
	</target>
</project>
